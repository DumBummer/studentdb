/* StudentDB / Calm Retro 2.0 — soft, legible, consistent.
   All selectors are presentation-only; database code is unchanged. */
QWidget { font-family: "Segoe UI"; font-size: 10pt; color: #34404A; }
QMainWindow, QDialog, QMessageBox { background: #F2F1ED; }
QFrame#sidebar { background: #E9ECEA; border: 1px solid #D9DFDC; border-radius: 12px; }
QFrame#content { background: #F8F8F5; border: 1px solid #DFE3DF; border-radius: 12px; }
QFrame#panel, QFrame#classFormCard, QFrame#classRecordsCard {
 background: #FFFFFF; border: 1px solid #E0E4E1; border-radius: 11px;
}
QScrollArea#navScroll, QScrollArea#navScroll QWidget { background: transparent; border: none; }
QLabel#navGroupLabel { font-size: 9pt; font-weight: 700; color: #798782; padding: 15px 9px 5px; }
QLabel#banner { background: #3F625E; color: #FFFFFF; font-size: 16pt;
 font-weight: 700; padding: 17px 22px; border: none; }
QLabel#footer { background: #E8EEEB; color: #60746D; padding: 9px 18px; font-size: 9pt; }
QLabel#sectionTitle { background: #E4EEEB; color: #355C57; font-size: 15pt;
 font-weight: 700; padding: 12px 16px; border: 1px solid #D5E3DE; border-radius: 9px; }
QLabel#subtitle { color: #687871; padding: 6px 10px; font-size: 9pt; }
QLabel#statLabel { background: #FFFFFF; border: 1px solid #DDE4E0;
 border-radius: 11px; padding: 16px; font-size: 21pt; font-weight: 700; color: #3C5B57; }
QPushButton { background: #FFFFFF; color: #394A48; border: 1px solid #CED8D3;
 border-radius: 8px; padding: 9px 13px; min-height: 22px; font-weight: 600; }
QPushButton:hover { background: #EDF3F0; border-color: #9DB7AC; }
QPushButton:pressed { background: #DAE7E1; }
QPushButton:disabled { background: #F2F3F0; color: #9BA6A0; border-color: #E0E5E1; }
QPushButton:focus { border: 2px solid #729E90; }
QPushButton#navButton { text-align: left; padding: 10px 13px; min-height: 23px;
 background: transparent; border: 1px solid transparent; font-weight: 500; }
QPushButton#navButton:hover { background: #F4F7F5; border-color: #DDE5E0; }
QPushButton#navButton:checked { background: #DCEAE4; color: #285B50;
 border: 1px solid #BDD3C8; font-weight: 700; }
QPushButton#primaryButton { background: #46796C; border-color: #46796C; color: white; }
QPushButton#primaryButton:hover { background: #3B695E; }
QPushButton#editButton { background: #E6EBF2; border-color: #CBD7E5; color: #355A78; }
QPushButton#dangerButton { background: #F7E9E7; border-color: #E9C9C5; color: #9A4D45; }
QPushButton#dangerButton:hover { background: #F2DAD7; }
QPushButton#backButton { background: #EEF1EF; color: #4B625C; }
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
 background: #FFFFFF; color: #34404A; border: 1px solid #C7D3CC;
 border-radius: 7px; padding: 8px 10px; min-height: 22px;
 selection-background-color: #BCD8CB; selection-color: #253D34;
}
QLineEdit:hover, QComboBox:hover, QDateEdit:hover { border-color: #9BB8A8; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QTextEdit:focus { border: 2px solid #6B9D88; }
QComboBox::drop-down { border: none; width: 27px; background: #E6EEEA;
 border-top-right-radius: 6px; border-bottom-right-radius: 6px; }
QComboBox QAbstractItemView { background: #FFFFFF; color: #34404A;
 border: 1px solid #CBD6CF; selection-background-color: #DFECE5;
 selection-color: #253D34; outline: none; }
QTableWidget, QTableView { background: #FFFFFF; alternate-background-color: #F7F9F7;
 border: 1px solid #D9E2DD; border-radius: 8px; gridline-color: #E7EBE8;
 selection-background-color: #DCEAE4; selection-color: #244E43; }
QHeaderView::section { background: #E7EEEA; color: #425F56; font-size: 9pt;
 font-weight: 700; border: none; border-right: 1px solid #D6E1DB;
 border-bottom: 1px solid #D6E1DB; padding: 9px 10px; }
QTableCornerButton::section { background: #E7EEEA; border: none; }
QTabWidget::pane { border: 1px solid #DCE3DE; border-radius: 9px;
 background: #FFFFFF; top: -1px; }
QTabBar::tab { background: #E9EEEA; color: #61716A; padding: 11px 18px;
 margin-right: 5px; border: 1px solid #D5DED8;
 border-top-left-radius: 8px; border-top-right-radius: 8px; min-width: 100px; }
QTabBar::tab:selected { background: #FFFFFF; color: #315C51;
 border-bottom-color: #FFFFFF; font-weight: 700; }
QTabBar::tab:hover { background: #F7FAF8; }
QGroupBox { background: #FFFFFF; border: 1px solid #DFE5E0;
 border-radius: 10px; margin-top: 14px; padding: 13px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; }
QScrollBar:vertical { background: #F0F2EF; width: 11px; border-radius: 5px; }
QScrollBar::handle:vertical { background: #C4D2C9; min-height: 30px; border-radius: 5px; }
QScrollBar:horizontal { background: #F0F2EF; height: 11px; border-radius: 5px; }
QScrollBar::handle:horizontal { background: #C4D2C9; min-width: 30px; border-radius: 5px; }
QSplitter::handle { background: #E3E9E5; width: 5px; }
QToolTip { background: #344F49; color: white; border: 1px solid #344F49; padding: 5px; }
