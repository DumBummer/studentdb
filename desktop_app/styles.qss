/* StudentDB Retro OS — classic beige + dark teal, inspired by supplied reference */
QWidget { font-family: 'Consolas', 'Segoe UI', monospace; font-size: 12px; color: #26291f; }
QMainWindow, QDialog { background: #dcd4bf; }
QFrame#sidebar { background: #c8c0ab; border: 2px solid #f6f0e2; border-right: 2px solid #7b796d; }
QFrame#content { background: #e9e2d2; border: 2px solid #807c70; }
QFrame#panel { background: #dcd4bf; border: 2px solid #807c70; }
QLabel#banner { background: #17433d; color: #f1e6cb; padding: 17px; font-size: 19px; font-weight: bold; }
QLabel#footer { background: #17433d; color: #f1e6cb; padding: 8px; }
QLabel#sectionTitle { background: #315e88; color: white; font-size: 16px; font-weight: bold; padding: 9px; }
QLabel#subtitle { padding: 4px 7px; color: #494d43; }
QLabel#statLabel { font-size: 25px; font-weight: bold; padding: 20px; background: #c8c0ab; border: 2px solid #807c70; }
QPushButton { background: #c8c0ab; padding: 8px 12px; border-top: 2px solid #faf6e9; border-left: 2px solid #faf6e9; border-bottom: 2px solid #6f6b60; border-right: 2px solid #6f6b60; }
QPushButton:hover { background: #e3dccb; }
QPushButton:pressed { border-top: 2px solid #6f6b60; border-left: 2px solid #6f6b60; border-bottom: 2px solid #faf6e9; border-right: 2px solid #faf6e9; }
QPushButton#primaryButton { background: #2b665e; color: white; font-weight: bold; }
QPushButton#primaryButton:hover { background: #367c70; }
QPushButton#dangerButton { color: #7d2525; }
QPushButton#navButton { text-align: left; padding: 10px; }
QPushButton#navButton:checked { background: #315e88; color: white; border-top: 2px solid #1a3b59; border-left: 2px solid #1a3b59; border-bottom: 2px solid #f6f0e2; border-right: 2px solid #f6f0e2; }
QLineEdit, QComboBox { background: #f7f3e8; border: 2px solid #898579; padding: 7px; selection-background-color: #315e88; }
QLineEdit:focus, QComboBox:focus { border: 2px solid #2b665e; }
QTableWidget { background: #f7f3e8; alternate-background-color: #e9e2d2; gridline-color: #ada594; border: 2px solid #807c70; selection-background-color: #315e88; selection-color: white; }
QHeaderView::section { background: #c8c0ab; color: #25251f; padding: 8px; border: 1px solid #807c70; font-weight: bold; }
QDialog { border: 2px solid #807c70; }
QMessageBox { background: #dcd4bf; }
